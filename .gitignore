# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/
.venv/
.pytest_cache/
.ruff_cache/
# CI-only JUnit report from the all-extras leg
# (trailing comments are NOT valid in .gitignore — keep these on their own lines)
pytest-extras.xml
# Coverage artifacts — regenerated by `make coverage` / the CI test-extras leg.
# CI uploads coverage.xml as an artifact; none of these belong in git.
.coverage
coverage.xml
htmlcov/

# Secrets & local config (Hard Rule #3)
.env
*.key
*.pem
secrets/

# Eval artifacts (regenerated; keep dirs via .gitkeep)
artifacts/traces/*
artifacts/grade_results/*
!artifacts/.gitkeep

# Course materials — never commit (large, not repo content)
*.pdf

# OS
.DS_Store

# Claude Code internals (worktrees, local session state)
.claude/worktrees/
.claude/settings.local.json

# ADK web playground local state (sessions, eval history)
.adk/
