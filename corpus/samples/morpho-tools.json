          "amount"
        ],
        "type": "object"
      },
      "name": "morpho_prepare_withdraw_collateral"
    },
    {
      "description": "Fetch a user's claimable Merkl rewards and prepare a single claim transaction against the canonical Merkl Distributor (0x3Ef3D8bA38EBe18DB133cEc108f4D14CE00Dd9Ae). Returns a ready-to-sign transaction; if nothing is claimable, returns an empty transactions array with an info-level warning. No on-chain approval needed \u2014 the Distributor pulls from its own balance via Merkle proofs.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false,
        "properties": {
          "chain": {
            "enum": [
              "ethereum",
