    {
      "description": "Prepare a supply of collateral tokens to a Morpho Blue market without borrowing. Checks on-chain allowance and returns a ready-to-sign transactions array with approval txs (if needed) followed by the supply collateral tx. Handles USDT reset-to-zero and DAI non-standard approval.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false,
        "properties": {
          "amount": {
            "description": "Collateral token amount in human-readable decimals (e.g., \"1.5\" for 1.5 WETH), or \"max\" for full balance",
            "type": [
              "string",
              "number"
            ]
          },
          "chain": {
            "enum": [
              "ethereum",
              "base",
              "arbitrum",
              "optimism",
              "polygon",
              "unichain",
              "worldchain",
              "katana",
              "hyperevm",
              "monad",
              "stable"
            ],
            "type": "string"
          },
          "marketId": {
            "errorMessage": {
