          },
          "userAddress": {
            "errorMessage": {
              "pattern": "Invalid Ethereum address"
            },
            "pattern": "^0x[a-fA-F0-9]{40}$",
            "type": "string"
          }
        },
        "required": [
          "chain",
          "userAddress"
        ],
        "type": "object"
      },
      "name": "morpho_prepare_claim_rewards"
    }
