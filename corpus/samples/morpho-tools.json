{
  "tools": [
    {
      "description": "Check the health status of the MCP server and connected services",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false,
        "properties": {},
        "type": "object"
      },
      "name": "morpho_health_check"
    },
    {
      "description": "Get list of supported blockchain networks",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false,
        "properties": {},
        "type": "object"
      },
      "name": "morpho_get_supported_chains"
    },
    {
      "description": "Query Morpho vaults with optional filtering and sorting",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false,
        "properties": {
          "assetAddress": {
            "errorMessage": {
              "pattern": "Invalid Ethereum address"
            },
            "pattern": "^0x[a-fA-F0-9]{40}$",
            "type": "string"
          },
          "assetSymbol": {
            "type": "string"
          },
          "chain": {
            "enum": [
              "ethereum",
              "base",
              "arbitrum",
              "optimism",
              "polygon",
              "unichain",
              "worldchain",
              "katana",
              "hyperevm",
              "monad",
              "stable"
            ],
            "type": "string"
          },
          "fields": {
            "items": {
              "enum": [
                "address",
                "name",
                "symbol",
                "apyPct",
                "tvl",
                "tvlUsd",
                "feePct"
              ],
              "type": "string"
            },
            "type": "array"
          },
          "limit": {
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          },
          "skip": {
            "minimum": 0,
            "type": "integer"
          },
          "sort": {
            "enum": [
              "apy_desc",
              "apy_asc",
              "tvl_desc",
              "tvl_asc"
            ],
            "type": "string"
          }
        },
        "required": [
          "chain"
        ],
        "type": "object"
      },
      "name": "morpho_query_vaults"
    },
    {
      "description": "Get details of a specific Morpho vault",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false,
        "properties": {
          "address": {
            "errorMessage": {
              "pattern": "Invalid Ethereum address"
            },
            "pattern": "^0x[a-fA-F0-9]{40}$",
            "type": "string"
          },
          "chain": {
            "enum": [
              "ethereum",
              "base",
              "arbitrum",
              "optimism",
              "polygon",
              "unichain",
              "worldchain",
              "katana",
              "hyperevm",
              "monad",
              "stable"
            ],
            "type": "string"
          }
        },
        "required": [
          "chain",
          "address"
        ],
        "type": "object"
      },
      "name": "morpho_get_vault"
    },
    {
      "description": "Query Morpho markets with optional filtering",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false,
        "properties": {
          "chain": {
            "enum": [
              "ethereum",
              "base",
              "arbitrum",
              "optimism",
              "polygon",
              "unichain",
              "worldchain",
              "katana",
              "hyperevm",
              "monad",
              "stable"
            ],
            "type": "string"
          },
          "collateralAsset": {
            "errorMessage": {
              "pattern": "Invalid Ethereum address"
            },
            "pattern": "^0x[a-fA-F0-9]{40}$",
            "type": "string"
          },
          "fields": {
            "items": {
              "enum": [
                "supplyApy",
                "borrowApy",
                "totalSupply",
                "totalBorrow",
                "totalCollateral",
                "totalLiquidity",
                "supplyAssetsUsd",
                "borrowAssetsUsd",
                "collateralAssetsUsd",
                "liquidityAssetsUsd"
              ],
              "type": "string"
            },
            "type": "array"
          },
          "limit": {
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          },
          "loanAsset": {
            "errorMessage": {
              "pattern": "Invalid Ethereum address"
            },
            "pattern": "^0x[a-fA-F0-9]{40}$",
            "type": "string"
          },
          "skip": {
            "minimum": 0,
            "type": "integer"
          },
          "sortBy": {
            "default": "supplyAssetsUsd",
            "enum": [
              "supplyApy",
              "borrowApy",
              "netSupplyApy",
              "netBorrowApy",
              "supplyAssetsUsd",
              "borrowAssetsUsd",
              "totalLiquidityUsd"
            ],
            "type": "string"
          },
          "sortDirection": {
            "default": "desc",
            "enum": [
              "asc",
              "desc"
            ],
            "type": "string"
          }
        },
        "required": [
          "chain"
        ],
        "type": "object"
      },
      "name": "morpho_query_markets"
    },
    {
      "description": "Get details of a specific Morpho market",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false,
        "properties": {
          "chain": {
            "enum": [
              "ethereum",
              "base",
              "arbitrum",
              "optimism",
              "polygon",
              "unichain",
              "worldchain",
              "katana",
              "hyperevm",
              "monad",
              "stable"
            ],
            "type": "string"
          },
          "id": {
            "errorMessage": {
              "minLength": "Market ID is required"
            },
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "chain",
          "id"
        ],
        "type": "object"
      },
      "name": "morpho_get_market"
    },
    {
      "description": "Get all Morpho positions for a user on a chain. Returns vaultPositions (all vaults) and marketPositions, with zero-balance entries filtered out.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false,
        "properties": {
          "chain": {
            "enum": [
              "ethereum",
              "base",
              "arbitrum",
              "optimism",
              "polygon",
              "unichain",
              "worldchain",
              "katana",
              "hyperevm",
              "monad",
              "stable"
            ],
            "type": "string"
          },
          "userAddress": {
            "errorMessage": {
              "pattern": "Invalid Ethereum address"
            },
            "pattern": "^0x[a-fA-F0-9]{40}$",
            "type": "string"
          }
        },
        "required": [
          "chain",
          "userAddress"
        ],
        "type": "object"
      },
      "name": "morpho_get_positions"
    },
    {
      "description": "Get token balance and whether the user needs to approve Morpho or the Bundler before writing. Balance and allowances are self-describing TokenAmounts.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false,
        "properties": {
          "chain": {
            "enum": [
              "ethereum",
              "base",
              "arbitrum",
              "optimism",
              "polygon",
              "unichain",
              "worldchain",
              "katana",
              "hyperevm",
              "monad",
              "stable"
            ],
            "type": "string"
          },
          "tokenAddress": {
            "errorMessage": {
              "pattern": "Invalid Ethereum address"
            },
            "pattern": "^0x[a-fA-F0-9]{40}$",
            "type": "string"
          },
          "userAddress": {
            "errorMessage": {
              "pattern": "Invalid Ethereum address"
            },
            "pattern": "^0x[a-fA-F0-9]{40}$",
            "type": "string"
          }
        },
        "required": [
          "chain",
          "userAddress",
          "tokenAddress"
        ],
        "type": "object"
      },
      "name": "morpho_get_token_balance"
    },
    {
      "description": "Search the Morpho documentation (docs.morpho.org) by semantic similarity. Returns raw search hits; each hit carries the matched text plus metadata (page title, absolute docs.morpho.org url, breadcrumbs, excerpt).",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false,
        "properties": {
          "query": {
            "description": "Natural-language search query",
            "minLength": 1,
            "type": "string"
          },
          "rerank": {
            "default": true,
            "description": "Rerank results for relevance",
            "type": "boolean"
          },
          "rewriteQuery": {
            "description": "Let the search service rewrite the query",
            "type": "boolean"
          },
          "scoreThreshold": {
            "description": "Only return results scoring at or above this relevance score",
            "type": "number"
          },
          "topK": {
            "default": 10,
            "description": "Maximum number of result chunks to return",
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "query"
        ],
        "type": "object"
      },
      "name": "morpho_doc_search"
    },
    {
      "description": "Prepare a deposit into a Morpho vault. Checks on-chain allowance and returns a ready-to-sign transactions array with approval txs (if needed) followed by the deposit tx. Handles USDT reset-to-zero and DAI non-standard approval.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false,
        "properties": {
          "amount": {
            "description": "Token amount in human-readable decimals (e.g., \"1000.50\"), or \"max\" for full balance",
            "type": [
              "string",
              "number"
            ]
          },
          "chain": {
            "enum": [
              "ethereum",
              "base",
              "arbitrum",
              "optimism",
              "polygon",
              "unichain",
              "worldchain",
              "katana",
              "hyperevm",
              "monad",
              "stable"
            ],
            "type": "string"
          },
          "userAddress": {
            "errorMessage": {
              "pattern": "Invalid Ethereum address"
            },
            "pattern": "^0x[a-fA-F0-9]{40}$",
            "type": "string"
          },
          "vaultAddress": {
            "errorMessage": {
              "pattern": "Invalid Ethereum address"
            },
            "pattern": "^0x[a-fA-F0-9]{40}$",
            "type": "string"
          }
        },
        "required": [
          "chain",
          "vaultAddress",
          "userAddress",
          "amount"
        ],
        "type": "object"
      },
      "name": "morpho_prepare_deposit"
    },
    {
      "description": "Prepare a withdraw from a Morpho vault. Returns a ready-to-sign transactions array. Supports \"max\" for full withdrawal. No approval needed for withdrawals.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false,
        "properties": {
          "amount": {
            "description": "Token amount in human-readable decimals (e.g., \"1000.50\"), or \"max\" for full withdrawal",
            "type": [
              "string",
              "number"
            ]
          },
          "chain": {
            "enum": [
              "ethereum",
              "base",
              "arbitrum",
              "optimism",
              "polygon",
              "unichain",
              "worldchain",
              "katana",
              "hyperevm",
              "monad",
              "stable"
            ],
            "type": "string"
          },
          "userAddress": {
            "errorMessage": {
              "pattern": "Invalid Ethereum address"
            },
            "pattern": "^0x[a-fA-F0-9]{40}$",
            "type": "string"
          },
          "vaultAddress": {
            "errorMessage": {
              "pattern": "Invalid Ethereum address"
            },
            "pattern": "^0x[a-fA-F0-9]{40}$",
            "type": "string"
          }
        },
        "required": [
          "chain",
          "vaultAddress",
          "userAddress",
          "amount"
        ],
        "type": "object"
      },
      "name": "morpho_prepare_withdraw"
    },
    {
      "description": "Prepare a supply to a Morpho Blue market. Checks on-chain allowance and returns a ready-to-sign transactions array with approval txs (if needed) followed by the supply tx. Handles USDT reset-to-zero and DAI non-standard approval.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false,
        "properties": {
          "amount": {
            "description": "Loan token amount in human-readable decimals (e.g., \"1000.50\"), or \"max\" for full balance",
            "type": [
              "string",
              "number"
            ]
          },
          "chain": {
            "enum": [
              "ethereum",
              "base",
              "arbitrum",
              "optimism",
              "polygon",
              "unichain",
              "worldchain",
              "katana",
              "hyperevm",
              "monad",
              "stable"
            ],
            "type": "string"
          },
          "marketId": {
            "errorMessage": {
              "pattern": "Invalid market ID (must be 66-char hex)"
            },
            "pattern": "^0x[a-fA-F0-9]{64}$",
            "type": "string"
          },
          "userAddress": {
            "errorMessage": {
              "pattern": "Invalid Ethereum address"
            },
            "pattern": "^0x[a-fA-F0-9]{40}$",
            "type": "string"
          }
        },
        "required": [
          "chain",
          "marketId",
          "userAddress",
          "amount"
        ],
        "type": "object"
      },
      "name": "morpho_prepare_supply"
    },
    {
      "description": "Prepare a borrow on a Morpho Blue market. Returns a ready-to-sign transactions array with the borrow tx. Includes health factor check against existing collateral position.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false,
        "properties": {
          "borrowAmount": {
            "description": "Loan token amount to borrow in human-readable decimals (e.g., \"500\"), or \"max\" for maximum borrowable",
            "type": [
              "string",
              "number"
            ]
          },
          "chain": {
            "enum": [
              "ethereum",
              "base",
              "arbitrum",
              "optimism",
              "polygon",
              "unichain",
              "worldchain",
              "katana",
              "hyperevm",
              "monad",
              "stable"
            ],
            "type": "string"
          },
          "marketId": {
            "errorMessage": {
              "pattern": "Invalid market ID (must be 66-char hex)"
            },
            "pattern": "^0x[a-fA-F0-9]{64}$",
            "type": "string"
          },
          "userAddress": {
            "errorMessage": {
              "pattern": "Invalid Ethereum address"
            },
            "pattern": "^0x[a-fA-F0-9]{40}$",
            "type": "string"
          }
        },
        "required": [
          "chain",
          "marketId",
          "userAddress",
          "borrowAmount"
        ],
        "type": "object"
      },
      "name": "morpho_prepare_borrow"
    },
